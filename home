<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jeffrey Jaymot | Professional Portfolio</title>

    <meta name="description"
        content="Professional portfolio of Jeffrey Jaymot, featuring leadership, kinesiology, education, research, athletics, and community programming.">

    <style>
        /* ===============================
           RESET
        =============================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #202124;
            background: #ffffff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        /* ===============================
           GLOBAL
        =============================== */

        .container {
            width: min(1120px, 90%);
            margin: 0 auto;
        }

        .section {
            padding: 90px 0;
        }

        .section-light {
            background: #f7f7f7;
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 15px;
            letter-spacing: -0.03em;
        }

        .section-intro {
            max-width: 720px;
            color: #60646c;
            margin-bottom: 45px;
            font-size: 1.05rem;
        }

        /* ===============================
           NAVIGATION
        =============================== */

        header {
            position: sticky;
            top: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid #e8e8e8;
            z-index: 1000;
        }

        nav {
            height: 72px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 28px;
            font-size: 0.92rem;
        }

        .nav-links a {
            color: #444;
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: #000;
        }

        /* ===============================
           HERO
        =============================== */

        .hero {
            min-height: 78vh;
            display: flex;
            align-items: center;
            padding: 100px 0;
        }

        .hero-content {
            max-width: 850px;
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.13em;
            font-size: 0.78rem;
            font-weight: 700;
            color: #737373;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(3rem, 8vw, 5.5rem);
            line-height: 1;
            letter-spacing: -0.055em;
            margin-bottom: 25px;
        }

        .hero-title {
            font-size: clamp(1.25rem, 3vw, 1.7rem);
            font-weight: 500;
            margin-bottom: 25px;
            color: #383838;
        }

        .hero-description {
            max-width: 740px;
            font-size: 1.15rem;
            color: #60646c;
            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 5px;
            font-size: 0.93rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: #181818;
            color: white;
        }

        .btn-primary:hover {
            background: #333;
        }

        .btn-secondary {
            border: 1px solid #ccc;
            background: white;
        }

        .btn-secondary:hover {
            border-color: #777;
        }

        /* ===============================
           PROFESSIONAL SNAPSHOT
        =============================== */

        .snapshot-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .snapshot-card {
            border-top: 3px solid #222;
            padding-top: 20px;
        }

        .snapshot-card h3 {
            font-size: 1.05rem;
            margin-bottom: 8px;
        }

        .snapshot-card p {
            font-size: 0.94rem;
            color: #686868;
        }

        /* ===============================
           CURRENT FOCUS
        =============================== */

        .focus-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .focus-card {
            padding: 35px;
            border: 1px solid #e4e4e4;
            border-radius: 8px;
            background: #fff;
        }

        .focus-number {
            font-size: 0.8rem;
            font-weight: bold;
            color: #999;
            margin-bottom: 45px;
        }

        .focus-card h3 {
            font-size: 1.25rem;
            margin-bottom: 12px;
        }

        .focus-card p {
            color: #666;
            font-size: 0.95rem;
        }

        /* ===============================
           CAREER HIGHLIGHTS
        =============================== */

        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .highlight {
            padding-right: 20px;
        }

        .highlight-value {
            font-size: 2.3rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            margin-bottom: 6px;
        }

        .highlight-label {
            color: #666;
            font-size: 0.92rem;
        }

        /* ===============================
           EDUCATION
        =============================== */

        .education-list {
            max-width: 850px;
        }

        .education-item {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            padding: 24px 0;
            border-bottom: 1px solid #ddd;
        }

        .degree {
            font-weight: 700;
        }

        .education-detail {
            color: #5e5e5e;
        }

        /* ===============================
           AREAS OF PRACTICE
        =============================== */

        .areas {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .area {
            border: 1px solid #d7d7d7;
            padding: 10px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            background: white;
        }

        /* ===============================
           CTA
        =============================== */

        .cta {
            padding: 100px 0;
            background: #181818;
            color: #fff;
        }

        .cta h2 {
            font-size: clamp(2.3rem, 5vw, 3.8rem);
            letter-spacing: -0.045em;
            max-width: 800px;
            margin-bottom: 20px;
        }

        .cta p {
            color: #bbb;
            max-width: 650px;
            margin-bottom: 30px;
            font-size: 1.05rem;
        }

        .cta .btn {
            background: white;
            color: #181818;
        }

        /* ===============================
           FOOTER
        =============================== */

        footer {
            background: #181818;
            color: #aaa;
            padding: 35px 0;
            border-top: 1px solid #303030;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            gap: 25px;
            font-size: 0.85rem;
        }

        /* ===============================
           RESPONSIVE
        =============================== */

        @media (max-width: 900px) {

            .snapshot-grid,
            .highlights-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .focus-grid {
                grid-template-columns: 1fr;
            }

            .nav-links {
                display: none;
            }
        }

        @media (max-width: 600px) {

            .section {
                padding: 65px 0;
            }

            .hero {
                min-height: auto;
                padding: 90px 0 70px;
            }

            .snapshot-grid,
            .highlights-grid {
                grid-template-columns: 1fr;
            }

            .education-item {
                grid-template-columns: 1fr;
                gap: 5px;
            }

            .footer-content {
                flex-direction: column;
            }
        }
    </style>
</head>


