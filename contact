<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact | Jeffrey Jaymot</title>

    <meta name="description"
        content="Contact Jeffrey Jaymot regarding professional opportunities, research, athletics, recreation, education, and program leadership.">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #202124;
            background: #ffffff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            width: min(1120px, 90%);
            margin: 0 auto;
        }

        .section {
            padding: 90px 0;
        }

        .section-light {
            background: #f7f7f7;
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 15px;
            letter-spacing: -0.03em;
        }

        .section-intro {
            max-width: 760px;
            color: #60646c;
            margin-bottom: 45px;
            font-size: 1.05rem;
        }

        /* ===============================
           NAVIGATION
        =============================== */

        header {
            position: sticky;
            top: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid #e8e8e8;
            z-index: 1000;
        }

        nav {
            height: 72px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 28px;
            font-size: 0.92rem;
        }

        .nav-links a {
            color: #444;
            transition: color 0.2s ease;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #000;
            font-weight: 600;
        }

        /* ===============================
           HERO
        =============================== */

        .page-hero {
            padding: 120px 0 100px;
        }

        .eyebrow {
            text-transform: uppercase;
            letter-spacing: 0.13em;
            font-size: 0.78rem;
            font-weight: 700;
            color: #737373;
            margin-bottom: 20px;
        }

        .page-hero h1 {
            font-size: clamp(3rem, 7vw, 5rem);
            line-height: 1;
            letter-spacing: -0.05em;
            margin-bottom: 28px;
            max-width: 900px;
        }

        .page-hero p {
            max-width: 760px;
            font-size: 1.2rem;
            color: #5f6368;
        }

        /* ===============================
           CONTACT OPTIONS
        =============================== */

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .contact-card {
            border: 1px solid #e2e2e2;
            border-radius: 8px;
            padding: 35px;
            background: #fff;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .contact-card:hover {
            transform: translateY(-3px);
            border-color: #aaa;
        }

        .contact-label {
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: #999;
            margin-bottom: 30px;
        }

        .contact-card h2 {
            font-size: 1.4rem;
            margin-bottom: 10px;
        }

        .contact-card p {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 22px;
        }

        .contact-link {
            display: inline-block;
            font-size: 0.92rem;
            font-weight: 600;
            border-bottom: 1px solid #222;
            padding-bottom: 2px;
        }

        /* ===============================
           CONTACT OVERVIEW
        =============================== */

        .overview-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 70px;
            align-items: start;
        }

        .overview-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #777;
        }

        .overview-content p {
            color: #51555a;
            font-size: 1.05rem;
            margin-bottom: 22px;
        }

        /* ===============================
           INTEREST AREAS
        =============================== */

        .interest-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .interest-tag {
            border: 1px solid #d7d7d7;
            padding: 10px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            background: white;
        }

        /* ===============================
           CTA
        =============================== */

        .cta {
            padding: 100px 0;
            background: #181818;
            color: #fff;
        }

        .cta h2 {
            font-size: clamp(2.2rem, 5vw, 3.6rem);
            letter-spacing: -0.045em;
            max-width: 800px;
            margin-bottom: 20px;
        }

        .cta p {
            color: #bbb;
            max-width: 650px;
            margin-bottom: 30px;
            font-size: 1.05rem;
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 5px;
            font-size: 0.93rem;
            font-weight: 600;
            background: white;
            color: #181818;
            transition: all 0.2s ease;
        }

        .btn:hover {
            background: #e9e9e9;
        }

        /* ===============================
           FOOTER
        =============================== */

        footer {
            background: #181818;
            color: #aaa;
            padding: 35px 0;
            border-top: 1px solid #303030;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            gap: 25px;
            font-size: 0.85rem;
        }

        /* ===============================
           RESPONSIVE
        =============================== */

        @media (max-width: 900px) {

            .nav-links {
                display: none;
            }

            .contact-grid {
                grid-template-columns: 1fr;
            }

            .overview-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }
        }

        @media (max-width: 600px) {

            .section {
                padding: 65px 0;
            }

            .page-hero {
                padding: 90px 0 70px;
            }

            .footer-content {
                flex-direction: column;
            }
        }
    </style>
</head>


<body>

    <!-- ===============================
         NAVIGATION
    =============================== -->

    <header>
        <div class="container">
            <nav>

                <a href="index.html" class="logo">Jeffrey Jaymot</a>

                <ul class="nav-links">
                    <li><a href="index.html">Home</a></li>
